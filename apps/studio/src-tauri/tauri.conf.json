{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LarkAura Studio",
  "version": "0.1.0",
  "identifier": "dev.larklabs.LarkAura.Studio",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [
      { "title": "LarkAura Studio", "width": 940, "height": 700, "minWidth": 780, "minHeight": 560 }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
